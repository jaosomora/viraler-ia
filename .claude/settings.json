{
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm install *)",
      "Bash(npm test*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'REPO=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -z \"$REPO\" ] && exit 0; SAFE=$(echo \"$REPO\" | sed \"s|/|-|g\"); MEMORY_SRC=\"$HOME/.claude/projects/$SAFE/memory\"; MEMORY_DST=\"$REPO/.claude/memory\"; if [ -d \"$MEMORY_SRC\" ] && [ -d \"$MEMORY_DST\" ]; then cp \"$MEMORY_SRC\"/*.md \"$MEMORY_DST/\" 2>/dev/null; fi; exit 0'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'REPO=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -z \"$REPO\" ] && exit 0; HOOK=\"$REPO/.claude/hooks/mcp-checks.sh\"; [ -x \"$HOOK\" ] && \"$HOOK\"; exit 0'"
          }
        ]
      }
    ]
  }
}
